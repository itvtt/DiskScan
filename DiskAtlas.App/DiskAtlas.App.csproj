<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 릴리스 버전의 바닥값: Actions 러너는 마지막 릴리스의 다음 번호를 고름 (예전 i-luncher 버전 1.0.3 부터 이어감) -->
    <Version>2.0.0</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DiskAtlas</AssemblyName>
    <AssemblyTitle>DiskScan</AssemblyTitle>
    <Product>DiskScan</Product>
    <RootNamespace>DiskAtlas.App</RootNamespace>
    <ApplicationIcon>Assets\DiskAtlas.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ILuncherIntegrated)' == 'true'">
    <OutputType>Library</OutputType>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup Condition="'$(ILuncherIntegrated)' == 'true'">
    <ApplicationDefinition Remove="App.xaml" />
    <Compile Remove="App.xaml.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DiskAtlas.Core\DiskAtlas.Core.csproj" />
    <Resource Include="Assets\DiskAtlas.ico" />
    <Resource Include="Assets\DiskAtlas.png" />
  </ItemGroup>
  <!-- i-luncher AppKit: 자체 업데이트(update.json)와 릴리스 zip -->
  <Import Project="AppKit\AppKit.targets" />
</Project>
